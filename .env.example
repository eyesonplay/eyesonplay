# Copy to .env and adjust. Local development works with the defaults; for
# production set every value marked REQUIRED (see docs/deployment.md).

# --- Production (docker-compose.prod.yml) ---------------------------------
DOMAIN=                        # REQUIRED in production, e.g. eyes.example.com (DNS must point here)
ADMIN_EMAIL=                   # REQUIRED in production: the first dashboard user
ADMIN_PASSWORD=                # REQUIRED in production: at least 10 characters
BACKUP_DIR=./backups           # nightly database dumps
BACKUP_KEEP_DAYS=14

# --- Database --------------------------------------------------------------
POSTGRES_USER=football
POSTGRES_PASSWORD=change-me    # REQUIRED in production; set before the first start
POSTGRES_DB=football

# --- Inference -------------------------------------------------------------
INFERENCE_MODE=mock            # mock | real
MAX_CONCURRENT_MATCHES=4
# Allow stream URLs on private/loopback hosts (SSRF guard). Development only.
ALLOW_PRIVATE_SOURCES=false

# --- Local development -----------------------------------------------------
# Without ADMIN_EMAIL/ADMIN_PASSWORD the dev stack signs in with
# admin@example.com / eyesonplay-admin.
API_PORT=8000
FRONTEND_PORT=3000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
MAX_UPLOAD_MB=4096
# Leave empty to let the browser use <dashboard host>:8000; "same-origin"
# behind a reverse proxy (set automatically in production).
NEXT_PUBLIC_API_URL=
LOG_LEVEL=INFO
