# Copy to .env and adjust. All values have working defaults for local development.
INFERENCE_MODE=mock            # mock | real
MAX_CONCURRENT_MATCHES=4
POSTGRES_USER=football
POSTGRES_PASSWORD=change-me
POSTGRES_DB=football
API_PORT=8000
FRONTEND_PORT=3000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
MAX_UPLOAD_MB=4096
# Leave empty to let the browser use <dashboard host>:8000
NEXT_PUBLIC_API_URL=
LOG_LEVEL=INFO
# Allow stream URLs on private/loopback hosts (SSRF guard). Development only.
ALLOW_PRIVATE_SOURCES=false
